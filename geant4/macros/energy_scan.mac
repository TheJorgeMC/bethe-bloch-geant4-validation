# ============================================================================
# energy_scan.mac — energy AND material sweep for the dE/dx vs E curve
# GENERATED by generate_energy_scan.py — do NOT edit by hand; edit the
# constants (and/or the NIST grid CSV) in that script and re-run it.
# Usage: ./slab macros/energy_scan.mac
#
# Sweeps ALL of water, aluminium, copper, lead in a single process. Each material
# block re-issues /absorber/material and /run/initialize: the production
# cut is stored as a fixed RANGE (0.01 mm), but Geant4 converts it to a
# material-specific ENERGY threshold when it rebuilds the physics tables
# in /run/initialize -- so re-initializing per material is not optional
# (design, section 5.3).
#
# Energy grid: NIST PSTAR grid from ../../nist_data/energy_grid.csv (132 points per material).
# Thickness follows the thin-slab rule t(E) = clamp(5% x range(E),
# 0.001 mm, 5 mm) using EACH material's own Bragg-Kleeman
# constants (bragg_kleeman_materials.py).
# Output files land in material_data/<material>/, created by this script.
# ============================================================================
/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
# --- Common conditions (material-independent) ----------------------------
/absorber/sizeXY 10 cm
/absorber/numberOfLayers 1
/physics/absorberCut 0.01 mm

# ============================================================================
# Material: water (G4_WATER)
# ============================================================================
/absorber/material G4_WATER
/run/initialize
/gun/particle proton

# --- 0.001 MeV  (t = 0.001 mm, seed 137979772 100638842)
/absorber/thickness 0.001 mm
/gun/energy 0.001 MeV
/analysis/setFileName material_data/water/dedx_water_0p001MeV_cut0p01mm
/random/setSeeds 137979772 100638842
/run/beamOn 10000000

